---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ReviewBanner from '../../../components/ReviewBanner.astro';
import ReadingTools from '../../../components/ReadingTools.astro';
import { getPublished } from '../../../lib/content';
import { SITE } from '../../../site.config';

export async function getStaticPaths() {
  const handouts = await getPublished('handouts');
  return handouts.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
---

<Base title={d.title} description={d.summary} bodyClass="older-adults">
  <Breadcrumbs items={[{ href: '/older-adults/', label: 'Older Adults Corner' }, { label: d.title }]} />
  <div class="container readable">
    <ReviewBanner status={d.reviewStatus} reviewer={d.reviewer} reviewDate={d.reviewDate} />
    <ReadingTools printable />
    <article class="handout">
      <h1>{d.title}</h1>
      <div class="prose"><Content /></div>
      <footer class="handout-foot">
        <p>
          From {SITE.name}, a free and open source project. Share freely under {SITE.contentLicense}.
          {d.sources.length > 0 && <>Based on guidance from: {d.sources.map((s) => s.title).join('; ')}.</>}
        </p>
      </footer>
    </article>
  </div>
</Base>

<style>
  .handout {
    background: var(--surface);
    border: 3px solid var(--ink);
    border-radius: var(--radius);
    padding: 1.5rem;
  }
  .handout h1 { margin-top: 0; }
  .handout :global(h2) { font-size: 1.35rem; }
  .handout :global(ol > li), .handout :global(ul > li) { margin-top: 0.5rem; }
  .handout :global(blockquote) {
    margin: 1rem 0;
    padding: 0.75rem 1rem;
    border: 3px solid var(--primary);
    border-radius: var(--radius-sm);
    font-size: 1.2em;
    font-weight: 700;
  }
  .handout-foot { margin-top: 1.5rem; padding-top: 0.75rem; border-top: 1px solid var(--line); font-size: 0.85em; color: var(--ink-soft); }

  @media print {
    .handout { border: 3px solid #000; border-radius: 0; padding: 1rem 1.25rem; font-size: 13pt; line-height: 1.45; }
    .handout h1 { font-size: 22pt; }
    .handout :global(h2) { font-size: 15pt; margin: 0.8em 0 0.3em; }
    .handout :global(blockquote) { border-color: #000; }
    .handout-foot { color: #000; font-size: 9pt; }
  }
</style>
