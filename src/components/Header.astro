---
import { SITE, AGE_LEVELS, AGE_LABELS } from '../site.config';
import { getPublished } from '../lib/content';

const hasGames = (await getPublished('gameDistricts')).length > 0;
const nav = [
  { href: '/cards/', label: 'Cards' },
  { href: '/videos/', label: 'Videos' },
  { href: '/articles/', label: 'Articles' },
  { href: '/stories/', label: 'Story Games' },
  ...(hasGames ? [{ href: '/games/', label: 'Games' }] : []),
  { href: '/concepts/', label: 'Topics' },
  { href: '/older-adults/', label: 'Older Adults Corner' },
];
const path = Astro.url.pathname;
const ageHints: Record<string, string> = {
  kids: 'Simpler words, game and chat examples',
  everyone: 'Clear advice for adults and teens',
  builders: 'Extra notes for people who build apps and websites',
};
---

<header class="site-header">
  <div class="container header-row">
    <a class="brand" href="/">
      <span class="brand-mark" aria-hidden="true">🛡️</span>
      <span>{SITE.name}</span>
    </a>

    <button class="menu-toggle btn btn--ghost btn--small" type="button" aria-expanded="false" aria-controls="site-nav">
      Menu
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="container controls-row">
    <fieldset class="age-toggle">
      <legend>Show content for</legend>
      <div class="segmented">
        {AGE_LEVELS.map((level) => (
          <label title={ageHints[level]}>
            <input type="radio" name="age-level" value={level} checked={level === 'everyone'} />
            <span>{AGE_LABELS[level]}</span>
          </label>
        ))}
      </div>
    </fieldset>

    <details class="display-options">
      <summary>Text size &amp; contrast</summary>
      <div class="display-panel panel">
        <fieldset>
          <legend>Text size</legend>
          <div class="segmented">
            <label><input type="radio" name="text-size" value="normal" checked /><span>A</span><span class="visually-hidden"> normal</span></label>
            <label><input type="radio" name="text-size" value="large" /><span style="font-size:1.15em">A</span><span class="visually-hidden"> large</span></label>
            <label><input type="radio" name="text-size" value="larger" /><span style="font-size:1.3em">A</span><span class="visually-hidden"> larger</span></label>
            <label><input type="radio" name="text-size" value="largest" /><span style="font-size:1.5em">A</span><span class="visually-hidden"> largest</span></label>
          </div>
        </fieldset>
        <label class="check">
          <input type="checkbox" name="high-contrast" />
          <span>High contrast colors</span>
        </label>
        <p class="hint">Saved on this device only.</p>
      </div>
    </details>
  </div>
</header>

<script>
  import { STORAGE_KEYS } from '../site.config';
  import { store } from '../scripts/storage';

  const root = document.documentElement;

  // Age level
  const ageInputs = document.querySelectorAll<HTMLInputElement>('input[name="age-level"]');
  ageInputs.forEach((input) => {
    input.checked = input.value === (root.dataset.age || 'everyone');
    input.addEventListener('change', () => {
      if (!input.checked) return;
      root.dataset.age = input.value;
      store.set(STORAGE_KEYS.age, input.value);
      document.dispatchEvent(new CustomEvent('sc:agechange', { detail: input.value }));
    });
  });

  // Text size
  const sizeInputs = document.querySelectorAll<HTMLInputElement>('input[name="text-size"]');
  sizeInputs.forEach((input) => {
    input.checked = input.value === (root.dataset.textSize || 'normal');
    input.addEventListener('change', () => {
      if (!input.checked) return;
      if (input.value === 'normal') {
        delete root.dataset.textSize;
        store.remove(STORAGE_KEYS.textSize);
      } else {
        root.dataset.textSize = input.value;
        store.set(STORAGE_KEYS.textSize, input.value);
      }
    });
  });

  // Contrast
  const contrast = document.querySelector<HTMLInputElement>('input[name="high-contrast"]');
  if (contrast) {
    contrast.checked = root.dataset.contrast === 'high';
    contrast.addEventListener('change', () => {
      if (contrast.checked) {
        root.dataset.contrast = 'high';
        store.set(STORAGE_KEYS.contrast, 'high');
      } else {
        delete root.dataset.contrast;
        store.remove(STORAGE_KEYS.contrast);
      }
    });
  }

  // Mobile menu
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!open));
      nav.classList.toggle('is-open', !open);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }
</script>

<style>
  .site-header {
    background: var(--surface);
    border-bottom: var(--border-w) solid var(--line);
  }
  .header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-top: 0.75rem;
    padding-bottom: 0.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--ink);
    text-decoration: none;
    min-height: 48px;
  }
  .brand-mark { font-size: 1.6rem; }

  .site-nav { display: none; width: 100%; }
  .site-nav.is-open { display: block; }
  .site-nav ul { list-style: none; margin: 0; padding: 0.25rem 0 0.5rem; display: flex; flex-direction: column; gap: 0.25rem; }
  .site-nav li + li { margin-top: 0; }
  .site-nav a {
    display: block;
    padding: 0.6rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--ink);
    text-decoration: none;
    font-weight: 700;
  }
  .site-nav a:hover { background: var(--surface-2); }
  .site-nav a[aria-current='page'] { background: var(--primary-soft); color: var(--primary); box-shadow: inset 0 -3px 0 var(--primary); }

  @media (min-width: 60rem) {
    .menu-toggle { display: none; }
    .site-nav { display: block; width: auto; }
    .site-nav ul { flex-direction: row; flex-wrap: wrap; padding: 0; }
    .site-nav a { padding: 0.5rem 0.65rem; }
  }

  .controls-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-bottom: 0.75rem;
  }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .age-toggle { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }
  legend { float: left; font-size: 0.9rem; font-weight: 700; color: var(--ink-soft); margin-right: 0.5rem; padding: 0; line-height: 44px; }
  .segmented {
    display: inline-flex;
    border: var(--border-w) solid var(--line);
    border-radius: 999px;
    padding: 3px;
    background: var(--surface-2);
  }
  .segmented { max-width: 100%; flex-wrap: wrap; }
  .segmented label { position: relative; }
  @media (max-width: 30rem) {
    .age-toggle legend { float: none; line-height: 1.4; margin-bottom: 0.25rem; }
    .segmented span:not(.visually-hidden) { padding: 0 0.6rem; }
  }
  .segmented input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .segmented span:not(.visually-hidden) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 38px;
    min-width: 44px;
    padding: 0 0.85rem;
    border-radius: 999px;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .segmented input:checked + span {
    background: var(--primary);
    color: var(--primary-ink);
  }
  .segmented input:focus-visible + span {
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .display-options { position: relative; }
  .display-options summary {
    cursor: pointer;
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--primary);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    padding: 0 0.5rem;
    border-radius: var(--radius-sm);
  }
  .display-panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.25rem);
    z-index: 20;
    width: min(20rem, calc(100vw - 2rem));
    display: grid;
    gap: 0.75rem;
  }
  .display-panel legend { float: none; line-height: 1.4; margin-bottom: 0.35rem; }
  .check { display: flex; align-items: center; gap: 0.6rem; min-height: 44px; font-weight: 700; cursor: pointer; }
  .check input { width: 1.4rem; height: 1.4rem; accent-color: var(--primary); }
  .hint { margin: 0; font-size: 0.85rem; color: var(--ink-soft); }

  @media print {
    .site-header { display: none; }
  }
</style>
