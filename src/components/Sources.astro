---
interface Props { sources: { title: string; url: string }[] }
const { sources } = Astro.props;
---

{sources.length > 0 && (
  <section class="sources" aria-labelledby="sources-h">
    <h2 id="sources-h">Sources</h2>
    <ul>
      {sources.map((s) => <li><a href={s.url} rel="noopener noreferrer">{s.title}</a></li>)}
    </ul>
  </section>
)}

<style>
  .sources { font-size: 0.95rem; margin-top: 2rem; }
  .sources h2 { font-size: 1.1rem; }
</style>
